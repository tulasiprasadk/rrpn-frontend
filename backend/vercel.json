{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "/api/route?handler=admin&path=:path*"
    },
    {
      "source": "/api/cms/:path*",
      "destination": "/api/route?handler=cms&path=:path*"
    },
    {
      "source": "/api/orders/:path*",
      "destination": "/api/route?handler=orders&path=:path*"
    },
    {
      "source": "/api/customer/address/guest",
      "destination": "/api/customer/address?guest=1"
    },
    {
      "source": "/api/customer/address/:id/default",
      "destination": "/api/customer/address?id=:id&default=1"
    },
    {
      "source": "/api/customer/address/:id",
      "destination": "/api/customer/address?id=:id"
    },
    {
      "source": "/api/products/:id",
      "destination": "/api/products?id=:id"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/auth/:path*"
    },
    {
      "source": "/customers/:path*",
      "destination": "/api/customers/:path*"
    },
    {
      "source": "/products/:path*",
      "destination": "/api/products/:path*"
    },
    {
      "source": "/categories",
      "destination": "/api/categories"
    },
    {
      "source": "/subscriptions/:path*",
      "destination": "/api/subscriptions/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
